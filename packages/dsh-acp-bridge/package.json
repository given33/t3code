{
  "name": "@t3tools/dsh-acp-bridge",
  "version": "0.1.0-t3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "vp pack && node --experimental-vm-modules=true scripts/check-imports.mjs",
    "prepare": "vp pack && node --experimental-vm-modules=true scripts/check-imports.mjs",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "test:cancel": "node scripts/cancel.mjs",
    "test:mcp": "node scripts/mcp.mjs",
    "test:mcp-stdio": "node scripts/mcp-stdio.mjs",
    "test:tools": "node scripts/tools.mjs",
    "test:modes": "node scripts/modes.mjs",
    "test:commands": "node scripts/commands.mjs",
    "test:handoff-modes": "node scripts/handoff-and-modes.mjs",
    "test:rewind": "node scripts/rewind.mjs",
    "test:steer": "node scripts/steer.mjs",
    "test:streaming": "node scripts/streaming.mjs",
    "test:text-generation": "node scripts/text-generation.mjs",
    "audit:server-mcp": "node scripts/audit-server-mcp.mjs",
    "test:parity": "node scripts/parity.mjs",
    "test:e2e": "node scripts/e2e-offline.mjs",
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
